# Copy this file to .env and fill in your own key.
# Use OPENAI_API_KEY for standard OpenAI keys or GEMINI_API_KEY for Gemini keys.
# You do not need both — the script prefers Gemini if GEMINI_API_KEY is set.
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
# Pin a concrete version for anything being written up; -latest aliases move.
# gemini-3.5-flash produced the taxonomy currently in data/ (see docs/PROGRESS.md).
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini
# Optional: LLM_PROVIDER=gemini|openai  (default: gemini if GEMINI_API_KEY is set)
